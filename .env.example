# Hetzner Cloud API token with read+write permissions
# Create one at: https://console.hetzner.cloud → Project → Security → API Tokens
API_TOKEN=

# Name of the Hetzner Cloud firewall to update (must already exist)
FIREWALL_NAME=

# Description of the firewall rule whose source IP will be updated
# This is used to identify the rule — it must match exactly
# Default if omitted: home-ip
RULE_DESCRIPTION=home-ip
